{
  "name": "@esfera/cli",
  "version": "0.3.1",
  "description": "esfera — convert spatial audio masters to IAMF / Eclipsa from the terminal.",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "esfera": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbitspatial/esfera-js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://developers.esfera.audio",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node test/smoke.node.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@esfera/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/orbitspatial/esfera-js/issues"
  },
  "keywords": [
    "spatial audio",
    "IAMF",
    "Eclipsa Audio",
    "ADM",
    "Dolby Atmos conversion",
    "Esfera"
  ]
}

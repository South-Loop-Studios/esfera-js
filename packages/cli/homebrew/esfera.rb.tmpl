# typed: false
# frozen_string_literal: true

# Esfera CLI — convert spatial audio masters to IAMF / Eclipsa from the terminal.
# Installs the published npm package on top of Homebrew's node; generated by
# packages/cli/scripts/brew-formula.mjs for each cli-v* release.
class Esfera < Formula
  desc "Convert spatial audio masters to IAMF / Eclipsa on the Esfera Converter API"
  homepage "https://developers.esfera.audio"
  url "https://registry.npmjs.org/@esfera/cli/-/cli-{{version}}.tgz"
  sha256 "{{sha256}}"
  license :cannot_represent

  depends_on "node"

  def install
    system "npm", "install", *std_npm_args
    bin.install_symlink Dir["#{libexec}/bin/*"]
  end

  test do
    assert_match "{{version}}", shell_output("#{bin}/esfera --version")
  end
end
